{
  "name": "homeassistant-desktop-portable",
  "repository": {
    "type": "git",
    "url": "https://github.com/codychen98/homeassistant-desktop-portable-release"
  },
  "version": "1.6.10",
  "description": "Windows portable fork of Home Assistant Desktop (data beside executable, no installer)",
  "author": "Dusty Armstrong <dusty@dustcloud.dev>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "electron app.js",
    "build-local-mac": "electron-builder build --mac --x64 --publish never",
    "build-local-mac-arm": "electron-builder build --mac --arm64 --publish never",
    "build-local-linux": "electron-builder build --linux appimage deb rpm --x64 --publish never",
    "build-local-linux-arm": "electron-builder build --linux appimage deb rpm --arm64 --publish never",
    "build-local-win": "electron-builder build --win --x64 --publish never",
    "build-local-win-arm": "electron-builder build --win --arm64 --publish never",
    "build-win-portable": "electron-builder build --win dir --x64 --publish never",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "~1.13.6",
    "bonjour-service": "~1.3.0",
    "electron-log": "~5.4.3",
    "electron-store": "~11.0.2",
    "electron-traywindow-positioner": "~1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "electron": "~41.0.3",
    "electron-builder": "~26.8.1",
    "eslint": "~10.1.0",
    "eslint-plugin-unused-imports": "~4.4.1",
    "globals": "~17.4.0",
    "npm-check-updates": "~19.6.5"
  },
  "engines": {
    "node": ">= 16"
  },
  "build": {
    "appId": "com.electron.homeassistant-dustytop",
    "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
    "productName": "Home Assistant Desktop",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "zip",
        "dmg"
      ],
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "./build/iconwin.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "public.app-category.productivity",
      "executableName": "Home Assistant Desktop",
      "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}"
    }
  }
}
